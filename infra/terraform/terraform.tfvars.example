# Example Terraform Variables Configuration File
# Copy to 'terraform.tfvars' and replace placeholders with real values.

kubeconfig_path    = "~/.kube/config"
namespace          = "theme-based-rag-workflow"
gemini_api_key     = "YOUR_GEMINI_API_KEY_HERE"
langsmith_tracing  = "true"
langsmith_api_key  = "YOUR_LANGSMITH_API_KEY_HERE"
langsmith_project  = "pr-virtual-cork-53"
chatbot_theme      = "Fintech SaaS platform"
backend_replicas   = 2
gateway_replicas   = 2
