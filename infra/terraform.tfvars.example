# Example Terraform Variables Configuration File
# Copy to 'terraform.tfvars' and replace placeholders with real values.

# Target Cluster Flag: Set to true for direct AWS EKS deployment, false for local cluster
use_aws_eks        = true
aws_region         = "us-east-1"
eks_cluster_name   = "theme-based-rag-eks"

# Fallback for local Kubernetes deployment when use_aws_eks = false
kubeconfig_path    = "~/.kube/config"

# Namespace & Secrets Configuration
namespace          = "theme-based-rag-workflow"
gemini_api_key     = "YOUR_GEMINI_API_KEY_HERE"
langsmith_tracing  = "true"
langsmith_api_key  = "YOUR_LANGSMITH_API_KEY_HERE"
langsmith_project  = "pr-virtual-cork-53"
chatbot_theme      = "Fintech SaaS platform"
backend_replicas   = 2
gateway_replicas   = 2
neo4j_username     = "neo4j"
neo4j_password     = "YOUR_NEO4J_PASSWORD_HERE"

