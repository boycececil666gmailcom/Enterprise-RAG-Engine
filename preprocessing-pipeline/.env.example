# OpenRouter API Configuration for RAPTOR preprocessing & summarization
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Fast & Cost-effective Model: DeepSeek V4 Flash
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Provider Routing: baidu (Baidu Qianfan provider slug on OpenRouter)
OPENROUTER_PROVIDER=baidu
# Free High-Performance Embedding Model: nvidia/nemotron-3-embed-1b:free
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
