#region OpenRouter Settings
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_TEMPERATURE=0
OPENROUTER_PROVIDER_SORT=throughput
OPENROUTER_PROVIDER_IGNORE=wafer
#endregion

#region Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=*
#endregion

#region Vector DB Settings
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
#endregion

#region JIRA Source Settings
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_API_TOKEN=
JIRA_EMAIL=
JIRA_JQL=issuetype = Bug ORDER BY created DESC
JIRA_MAX_RESULTS=5
#endregion

#region LangSmith Settings
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=mock_key
LANGSMITH_PROJECT=Enterprise-RAG-Engine
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
#endregion