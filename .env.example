#region Gemini LLM & Embedding Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_TEMPERATURE=0.0
#endregion

#region Backend Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
#endregion

#region Gateway Server Settings
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
RAG_BACKEND_URL=http://backend:8000
ALLOWED_ORIGINS=*
#endregion

#region Vector Database Settings (Qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
#endregion

#region Graph Database Settings (Neo4j)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4jpassword123
#endregion

#region Application Domain Settings
CHATBOT_THEME=Fintech SaaS platform
#endregion

#region LangSmith Observability Settings
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=pr-virtual-cork-53
#endregion
