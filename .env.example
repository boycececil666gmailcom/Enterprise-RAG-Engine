#region OpenRouter LLM & Embedding Settings
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_PROVIDER=baidu
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_TEMPERATURE=0.2
#endregion

#region Backend Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
#endregion

#region Gateway Server Settings
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
RAG_BACKEND_URL=http://backend:8000
ALLOWED_ORIGINS=*
#endregion

#region Vector Database Settings (Qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
#endregion

#region Graph Database Settings (Neo4j)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4jpassword123
#endregion

#region Application Domain Settings
CHATBOT_THEME=Fintech SaaS platform
#endregion

#region LangSmith Observability Settings
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=pr-virtual-cork-53
#endregion
